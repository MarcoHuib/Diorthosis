<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- LLamaSharp's native resolver has a fallback using Assembly.Location; Diorthosis configures an AppContext-based native search path and CI executes a backend-load check for each RID. -->
    <NoWarn>$(NoWarn);IL3000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Diorthosis.Core/Diorthosis.Core.csproj" />
  </ItemGroup>
</Project>
