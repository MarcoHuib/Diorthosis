<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <!-- Same pinned resolver warning as the CLI; Core sets AppContext.BaseDirectory search paths. -->
    <NoWarn>$(NoWarn);IL3000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Diorthosis.Core/Diorthosis.Core.csproj" />
  </ItemGroup>
</Project>
